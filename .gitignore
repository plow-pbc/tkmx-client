node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Sparkle agent worktree metadata (written by the desktop app, not repo content).
# Ignore the CONTENTS, not the directory: git never descends into an excluded
# directory, so a bare `.sparkle/` makes the negation below unreachable. That is
# exactly how merge-policy.json -- hand-written repo policy, not app runtime
# state -- got silently untracked one commit after it was deliberately added.
.sparkle/*
!.sparkle/merge-policy.json
