node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# Sparkle writes .sparkle/merge-policy.json into every agent worktree; without
# this, `git status` is permanently dirty and worker spin-down refuses.
.sparkle/

# The beads database (.beads/embeddeddolt/) and its server artifacts are already
# covered by the tracked .beads/.gitignore. interactions.jsonl is not: bd appends
# to it on every issue mutation, so tracking it leaves the worktree permanently
# dirty and can publish local absolute paths from the audit log into this public
# repo. .beads/issues.jsonl is deliberately left un-ignored so that the passive
# export can be committed if this repo decides to version it.
.beads/interactions.jsonl
