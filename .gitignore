node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# This repo now tracks .claude/settings.json, so the sibling local override has
# to be excluded explicitly. settings.local.json holds absolute per-machine
# paths and a permission allowlist, and until now was kept out only by a
# per-clone .git/info/exclude — which no other clone inherits. Same leak class
# the .beads/ hook wrappers were removed for.
.claude/settings.local.json
