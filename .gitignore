node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# bd init writes these hook wrappers with the generating machine's absolute
# home path baked in, plus a timestamped post-commit backup. This repo is
# public, so they are machine-local, not shareable. .beads/metadata.json stays
# TRACKED — project_id/dolt_database are the shared identity refs/dolt/data
# sync needs.
.beads/hooks/
.beads/*.bak-*
.beads/interactions.jsonl
