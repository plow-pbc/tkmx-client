node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
# Keep this credential pattern at the repo root even though `.beads/.gitignore`
# repeats it: a slash-free pattern matches at every depth, so a stray key
# written outside `.beads/` is still ignored. This repo is public.
.beads-credential-key
# Machine-local beads state. The git hook wrappers hardcode an absolute path to
# the developer's home directory, and interactions.jsonl is a per-clone log;
# `bd init` regenerates both locally. metadata.json is deliberately NOT ignored
# — it carries the shared project_id/dolt_database identity that clones must
# agree on for `refs/dolt/data` sync, and `.beads/.gitignore` tracks it by design.
.beads/hooks/
.beads/interactions.jsonl

# Sparkle writes .sparkle/merge-policy.json into every agent worktree, which
# otherwise leaves each one permanently dirty and blocks worktree teardown.
.sparkle/
