node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# Findings that scripts/file-retro-pain-point.sh could not file get parked here
# with their prose intact, to be re-filed on the next run. That is working state,
# never a deliverable, and this repo is public — so keep it out of `git add -A`.
# Scoped to the one file rather than all of .beads/, whose tracked-vs-ignored
# split (metadata.json is shared sync identity and must stay tracked) belongs
# with the beads scaffolding, not here.
.beads/retro-pain-point-drops.jsonl
