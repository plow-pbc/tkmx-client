node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# bd init writes these hook wrappers with the generating developer's ABSOLUTE
# home path baked in (/Users/<name>/.local/bin/roborev, ...). This repo is
# public, so committing them publishes a machine layout and gives every other
# clone a hook that points at a path they do not have. They are regenerated by
# `bd init` locally, so nobody needs them from git.
.beads/hooks/
.beads/*.bak-*
# Per-developer interaction log; noise, not shared state.
.beads/interactions.jsonl
