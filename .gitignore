node_modules/
# .env and any hand-rolled backup of it carry a live API_KEY. This repo is
# public, so an untracked .env* in the working tree is one `git add -A` away
# from publishing a credential. Ignore the whole class rather than one spelling
# (.env.bak, .env.old, .env.backup, .env.2 are all just as likely as
# .env.bak-<date>), then re-admit the tracked template.
.env*
!.env.example
.machine_config_hash
.reporting-state.json
.agentsview-update-check
dist/
*.tsbuildinfo

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Sparkle agent worktrees get a .sparkle/ marker written by the app. Without
# this, every agent worktree reads as dirty and worker teardown refuses with
# "holds uncommitted changes". Ignoring it here makes the fix durable rather
# than depending on a machine-local .git/info/exclude.
.sparkle/
